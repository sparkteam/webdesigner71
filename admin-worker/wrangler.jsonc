{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webdesigner71-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  // Create with: npx wrangler kv namespace create USERS   -> paste the id below
  "kv_namespaces": [
    { "binding": "USERS", "id": "4f8644922b684a2f9233b4f059f1898d" },
    // CMS Phase 1 homepage content (shared with the `webdesigner71` site Worker)
    { "binding": "CONTENT", "id": "3f74fcbc2ed24005b175a784968c3c3e" }
  ],

  "vars": {
    "ADMIN_EMAIL": "sohelhoo@gmail.com",
    "GOOGLE_CLIENT_ID": "641726616941-8qoe6tn0qtvmuidgtgtma9mrlkmqpja4.apps.googleusercontent.com",
    "EMAIL_FROM": "WebDesigner71 Admin <onboarding@resend.dev>",
    "ALLOWED_ORIGINS": "https://webdesigner71.com,https://www.webdesigner71.com"
  },

  // Secrets (NOT in this file). Set with `npx wrangler secret put <NAME>`:
  //   SESSION_SECRET   - random, >= 32 chars (signs 12h login tokens)
  //   APPROVAL_SECRET  - random, >= 32 chars (signs approve/reject email links)
  //   RESEND_API_KEY   - from resend.com (if missing, emails are only logged)

  // Custom domain (Cloudflare creates the DNS record for this subdomain):
  "routes": [
    { "pattern": "api.webdesigner71.com", "custom_domain": true }
  ],
  "workers_dev": true
}
