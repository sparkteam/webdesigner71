{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Site Worker for webdesigner71.com + www (custom domains are attached in the Cloudflare dashboard).
  // Deploy from the repo root:  npx wrangler deploy
  // Only ./public is uploaded; docs/, admin-worker/, site-worker/ and this file are never served.
  "name": "webdesigner71",
  "main": "site-worker/src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the homepage (CMS rewrite) and /media/* (uploaded images) run the script; the rest is served directly.
    "run_worker_first": ["/", "/index.html", "/media/*"]
  },
  // CMS homepage content + settings (written by the webdesigner71-admin Worker)
  // MEDIA: uploaded images. R2 is not enabled on this account yet, so this is a KV namespace
  // ("webdesigner71-media"). To move to R2 later: enable R2, create bucket webdesigner71-media, replace this
  // entry with  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "webdesigner71-media" }]  (code handles both).
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "3f74fcbc2ed24005b175a784968c3c3e" },
    { "binding": "MEDIA", "id": "51450a6f4dac48619c4c5ffa2764f1a4" }
  ]
}
